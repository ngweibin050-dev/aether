{"nodes": [{"id": "architecture", "label": "AETHER 2.0 Architecture", "file_type": "document", "source_file": "ARCHITECTURE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_shared_scene_state", "label": "One State, Three Ways to Edit (shared tools)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laptop gizmo, hand controller and AI agent all call the same tools (add_part, update_part, build_assembly) on server-owned state.parts, so mode switching (Tab) is instant and lossless; undo/redo snapshots parts and restores via /api/scene."}, {"id": "architecture_single_geometry_source", "label": "Single Geometry Source (Python builds meshes)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "engine/geometry.py builds every mesh and the browser only draws /api/meshes, so the picture shown equals the geometry the physics engine uses."}, {"id": "architecture_laptop_mode", "label": "Laptop Mode (Blender-style gizmo, outliner, shortcuts)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_hand_mode", "label": "Hand Mode (MediaPipe Hand Landmarker gestures)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a plain webcam with 21 joints per hand in-browser; pinch to drag, two-hand pinch rotate/scale, fist deselect, both palms calculate. Joints sent to server twice a second for occlusion check."}, {"id": "architecture_text_to_cad", "label": "Text-to-CAD (build_assembly part library)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Muse Spark writes assemblies as JSON from a parametric library (gear, tube, cylinder, cone, sphere, torus, box, nozzle, coil, blade ring, pipe); server validates and reports rejected parts back so the model can fix them. Results are simplified parametric models, not manufacturer data."}, {"id": "architecture_import_mesh_decimation", "label": "import_mesh with Vertex-Clustering Decimation", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imported GLB meshes are decimated to ~4,000 triangles and scaled to ~80 mm so they cannot overload the optics; UV unwrapping skipped since holograms use single laser colour without textures."}, {"id": "architecture_hidden_surface_removal", "label": "Hidden-Surface Removal via Angular Z-Buffer", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_point_cloud_cgh", "label": "Point-Cloud Computer-Generated Hologram", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_anti_aliasing_disc", "label": "Fringe-Frequency Anti-Aliasing Disc", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_wavefront_recording_plane", "label": "Wavefront Recording Plane (multi-plane WRP)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Points cut into 1.5 mm depth slabs written to nearby planes so windows are tiny, then propagated by angular spectrum; 5x faster than direct and focuses better."}, {"id": "architecture_shimobaba_2009", "label": "Shimobaba 2009 (WRP)", "file_type": "paper", "source_file": "ARCHITECTURE.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_phase_only_encoding", "label": "Phase-Only Encoding for Phase SLM", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_band_limited_angular_spectrum", "label": "Band-Limited Angular Spectrum Method", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_matsushima_2009", "label": "Matsushima 2009 (band-limited ASM)", "file_type": "paper", "source_file": "ARCHITECTURE.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_focus_sweep", "label": "Focus Sweep (true focus cues)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_eye_view", "label": "Eye View through Pupil (optics.eye_view)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_two_scales", "label": "Two Scales (lab-scale SLM vs desk-scale geometric laws)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 27-inch hologram needs ~3e7 pixels at 45 um, so full wave simulation runs on a 1024^2 x 8 um lab SLM with the scene shrunk uniformly; desk-scale questions use geometric laws and the eye model."}, {"id": "architecture_window_law", "label": "H1 Window Law (window_check)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_hand_shadow_rule", "label": "Hand-Shadow Rule / Depth Conflict (hand_check)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hand on the panel-to-P segment blocks light that should appear in front of the hand: a depth conflict software cannot fix; a hand on P-to-eye is ordinary occlusion."}, {"id": "architecture_desk_sharpness", "label": "Desk Sharpness 1D-Hologram Eye Model (desk_check, search_column_width)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_sharp_zone", "label": "Sharp Zone (+/-100 mm of panel)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Within +/-100 mm the desk keeps 78-90% of full sharpness; floating at 25 cm would need kHz phase modulators which do not exist yet."}, {"id": "architecture_aether_physics_record", "label": "AETHER Physics Record / Physics v9, v11, v13", "file_type": "document", "source_file": "ARCHITECTURE.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_speckle_analysis", "label": "Speckle Analysis (sparse point groups)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At k=3 contrast drops 0.995 -> 0.358 (random frames) and 0.288 (sparse groups), still far above the ~0.03-0.04 visible threshold, so speckle is reported honestly as an open problem."}, {"id": "architecture_verschaffelt_2015", "label": "Verschaffelt 2015 (speckle visibility threshold)", "file_type": "paper", "source_file": "ARCHITECTURE.md", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_compute_backend", "label": "Compute Backend (CuPy on Modal T4 / NumPy fallback)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_muse_spark", "label": "Muse Spark 1.3 Agent (18 tools)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explanations must quote tool results."}, {"id": "architecture_muse_voice_transcribe", "label": "Muse Voice Transcribe (hold-to-talk)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_physics_tests", "label": "Physics Test Suite (6 checks)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_omitted_features", "label": "Omitted Features (node material editor, WebXR, Meshy/Luma)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node editor adds UI without changing single-colour laser physics; WebXR contradicts the no-headset goal; Meshy/Luma are paid and not Meta tooling, but import_mesh accepts their GLB output."}], "edges": [{"source": "architecture", "target": "server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L13", "weight": 1.0}, {"source": "architecture", "target": "agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L14", "weight": 1.0}, {"source": "architecture", "target": "compute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L14", "weight": 1.0}, {"source": "architecture_shared_scene_state", "target": "server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L21", "weight": 1.0}, {"source": "architecture_shared_scene_state", "target": "architecture_laptop_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L23", "weight": 1.0}, {"source": "architecture_shared_scene_state", "target": "architecture_hand_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L23", "weight": 1.0}, {"source": "architecture_shared_scene_state", "target": "architecture_muse_spark", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L23", "weight": 1.0}, {"source": "architecture_single_geometry_source", "target": "engine_geometry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_location": "L27", "weight": 1.0}, {"source": "architecture_hand_mode", "target": "architecture_hand_shadow_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ARCHITECTURE.md", "source_l